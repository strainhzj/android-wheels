# 固定版本清单（单一来源）——任何改动走 PR 并更新 docs/gate.md 的决策记录
# 注意：NDK API / wheel tag 是"待首次 CI 验证的基线"，验证结论回填本文件。

# pydantic-core（与 BtDeck backend/requirements.txt 的 pydantic 版本配套）
# pydantic 2.12.4 依赖 pydantic-core 2.41.5（发布于 PyPI sdist，无 Android wheel）
PYDANTIC_CORE_VERSION=2.41.5
PYDANTIC_CORE_SDIST_SHA256=TBD_FIRST_CI_RUN

# Python（Android）
CHAQUOPY_PYTHON_VERSION=3.12

# 构建工具链
RUST_TOOLCHAIN=stable
CARGO_NDK_VERSION=3.3.0
ANDROID_NDK_VERSION=27.0.12077973
ANDROID_API_LEVEL=24          # Chaquopy min API（以官方版本矩阵为准）

# 每个 ABI 的 Rust target 与 Android wheel platform tag 基线
# platform tag 以 Chaquopy server/pypi README 为准，首次 CI 用 packaging.tags 校验后回填
ABI_arm64_v8a_TARGET=aarch64-linux-android
ABI_arm64_v8a_TAG=TBD
ABI_armeabi_v7a_TARGET=armv7-linux-androideabi
ABI_armeabi_v7a_TAG=TBD
ABI_x86_64_TARGET=x86_64-linux-android
ABI_x86_64_TAG=TBD
ABI_x86_TARGET=i686-linux-android
ABI_x86_TAG=TBD

# BtDeck 完整 import graph 的 ABI 敏感依赖清单（Phase 0B.4 矩阵覆盖项）
# 纯 Python 依赖直接走 PyPI，不在此列
ABI_SENSITIVE_DEPS="pydantic-core bcrypt regex Pillow pycryptodomex gmssl"
