# 固定版本清单（单一来源）——任何改动走 PR 并更新 docs/gate.md 的决策记录
# 2026-08-28 首建修正（详见 docs/gate.md 决策记录）：
#   - cargo-ndk 不在 PyPI，经 cargo install 安装；
#   - maturin 无 --abi3 参数；pydantic-core 2.41.5 亦无 abi3 feature → 版本专属 wheel；
#   - Chaquopy 15.0.1 起 Python 3.12+ 不支持 32 位 ABI（armeabi-v7a/x86）→ 矩阵收敛为两 ABI；
#   - Chaquopy 仓库 wheel 实测 tag 形态：cp312-cp312-android_21_arm64_v8a（PEP 738），
#     本仓按 NDK API 24 构建锚定 android_24_<abi>。

# pydantic-core（与 BtDeck backend/requirements.txt 的 pydantic 版本配套）
# pydantic 2.12.4 依赖 pydantic-core 2.41.5（发布于 PyPI sdist，无 Android wheel）
PYDANTIC_CORE_VERSION=2.41.5
PYDANTIC_CORE_SDIST_SHA256=08daa51ea16ad373ffd5e7606252cc32f07bc72b28284b6bc9c6df804816476e

# bcrypt（官方仓库存量 3.2.2 在 Android15 16K 镜像 dlopen 失败，自建 5.0.0 对齐后端 pin）
BCRYPT_VERSION=5.0.0
BCRYPT_SDIST_SHA256=f748f7c2d6fd375cc93d3fba7ef4a9e3a092421b8dbf34d8d4dc06be9492dfdd

# setuptools 系 C/C++ 扩展自建（官方仓库存量 wheel 在 Android15 16K 镜像不可载）
GREENLET_VERSION=3.0.1
GREENLET_SDIST_SHA256=816bd9488a94cba78d93e1abb58000e8266fa9cc2aa9ccdd6eb0696acb24005b
REGEX_VERSION=2024.11.6
REGEX_SDIST_SHA256=7ab159b063c52a0333c884e4679f8d7a85112ee3078fe3d9004b2dd875585519
PYCRYPTODOMEX_VERSION=3.23.0
PYCRYPTODOMEX_SDIST_SHA256=71909758f010c82bc99b0abf4ea12012c98962fbf0583c2164f8b84533c2e4da

# Python（Android）
CHAQUOPY_PYTHON_VERSION=3.12

# 构建工具链
RUST_TOOLCHAIN=stable
CARGO_NDK_VERSION=3.3.0
ANDROID_NDK_VERSION=27.0.12077973
ANDROID_API_LEVEL=24          # Chaquopy 17 min API（官方版本矩阵为准）

# 每个 ABI 的 Rust target 与 Android wheel platform tag
# （Chaquopy/Python 3.12 支持集 = arm64-v8a + x86_64；32 位 ABI 已废弃，不再构建）
ABI_arm64_v8a_TARGET=aarch64-linux-android
ABI_arm64_v8a_TAG=android_24_arm64_v8a
ABI_x86_64_TARGET=x86_64-linux-android
ABI_x86_64_TAG=android_24_x86_64

# BtDeck 完整 import graph 的 ABI 敏感依赖清单（Phase 0B.4 矩阵覆盖项）
# 纯 Python 依赖直接走 PyPI，不在此列
# 2026-08-28 官方仓库存量核查（chaquo.com/pypi-13.1）+ PyPI 实查：
#   bcrypt / regex / pillow / pycryptodomex —— Chaquopy 官方仓库已有 Android wheel，直接使用；
#   gmssl 3.2.2 —— PyPI 提供 py3-none-any 纯 Python wheel，非 ABI 敏感；
#   pydantic-core —— 官方仓库无 Android wheel，本仓自建（本 workflow），唯一自建项
ABI_SENSITIVE_DEPS="pydantic-core"
